# terraform/secrets.sops.env の雛形である。値は入れない。
#
# 実物は sops で直接作る。平文をディスクに残さないためである。
#
#   sops terraform/secrets.sops.env
#
# 開いたエディタにこのファイルの中身を写し、値を埋めて保存する。

# Terraform 用の Cloudflare API トークン。
# cert-manager と external-dns のランタイム用トークンとは分ける。
# 権限は Account の Cloudflare Tunnel（新しい UI では
# 「Cloudflare One Connector: cloudflared」）の Edit、
# Zone の Zone Settings の Edit、Zone の Zone の Read。
CLOUDFLARE_TERRAFORM_API_TOKEN=

# Cloudflare のアカウント ID。
# ~/.cloudflared/<Tunnel UUID>.json の AccountTag と同じ値である。
CLOUDFLARE_ACCOUNT_ID=

# Tunnel の資格情報。~/.cloudflared/<Tunnel UUID>.json の TunnelSecret である。
# API から読み出せないため import では state に入らず、こちらから与える必要がある。
# 同じ値がクラスターの cloudflared-credentials にもある。片方だけ変えない。
CLOUDFLARE_TUNNEL_SECRET=

# state を置く R2 バケット（homelab-terraform-state）に限定した R2 API トークン。
# 権限は Object Read & Write。トークン作成時に一度だけ表示される
# Access Key ID と Secret Access Key を控える。
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# state と plan の暗号化に使うパスフレーズ。16 文字以上。
# 失うと state を読めなくなる。ただし全リソースが import 可能なので復旧はできる。
TERRAFORM_STATE_PASSPHRASE=
